# Edge Function lokal (npm run api:dev). Salin menjadi ".env" di folder utama. File .env TIDAK di-commit.
# Produksi tidak membaca file ini: pakai `npx supabase secrets set NAMA=nilai` (docs/DEPLOYMENT.md).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# AI_DAILY_QUOTA=30
# AI_MONTHLY_BUDGET_USD=5
# Kosong = kuota disimpan di memori. Isi dengan connection string Supabase (Session pooler) bila perlu.
DATABASE_URL=
