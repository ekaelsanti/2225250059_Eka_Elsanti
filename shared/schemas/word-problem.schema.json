        "model": {
          "default": 0,
          "title": "Model",
          "type": "integer"
        },
        "rows": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
                "pattern": "^-?\\d+(/\\d+)?$",
                "type": "string"
              },
              {
                "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
                "pattern": "^-?\\d+(/\\d+)?$",
                "type": "string"
