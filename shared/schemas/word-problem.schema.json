          "maxItems": 3,
          "minItems": 3,
          "title": "Hints",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "text",
        "hints"
      ],
      "title": "Step",
      "type": "object"
    },
    "Stimulus": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "table",
            "graph"
