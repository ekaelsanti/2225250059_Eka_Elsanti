        "interpretation": {
          "items": {
            "type": "string"
          },
          "title": "Interpretation",
          "type": "array"
        },
        "reasonableness": {
          "items": {
            "type": "string"
          },
          "title": "Reasonableness",
          "type": "array"
        }
      },
      "required": [
        "answers",
        "steps",
        "accepted_forms",
        "interpretation",
        "reasonableness"
      ],
      "title": "Solution",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
