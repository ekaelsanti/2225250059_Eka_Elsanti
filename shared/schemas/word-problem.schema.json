          "type": "string"
        },
        "unit": {
          "description": "Satuan, mis. 'km', 'rupiah'",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "meaning",
        "unit"
      ],
      "title": "Variable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Soal cerita lengkap hasil build (dipakai aplikasi JavaScript secara offline).",
