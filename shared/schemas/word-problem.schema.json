{
  "$defs": {
    "Annotations": {
      "additionalProperties": false,
      "properties": {
        "known": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Known",
          "type": "array"
        },
        "asked": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Asked",
          "type": "array"
        },
        "distractor": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Distractor",
          "type": "array"
        }
      },
      "title": "Annotations",
      "type": "object"
    },
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "task": {
          "enum": [
            "find_rate",
            "find_initial",
            "build_model",
            "predict",
            "inverse",
            "intersect",
            "compare",
            "steepness",
            "parallel",
            "perpendicular"
          ],
          "title": "Task",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
              "pattern": "^-?\\d+(/\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "display": {
          "title": "Display",
          "type": "string"
        }
      },
      "required": [
        "key",
        "task",
        "display"
      ],
      "title": "Answer",
      "type": "object"
    },
    "LinearModel": {
      "additionalProperties": false,
      "description": "Model y = m x + c dalam konteks.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "x": {
          "$ref": "#/$defs/Variable"
        },
        "y": {
          "$ref": "#/$defs/Variable"
        },
        "m": {
          "description": "Laju perubahan (satuan y per satuan x)",
          "pattern": "^-?\\d+(/\\d+)?$",
          "title": "M",
          "type": "string"
        },
        "c": {
          "description": "Nilai awal (y saat x = 0)",
          "pattern": "^-?\\d+(/\\d+)?$",
          "title": "C",
          "type": "string"
        },
        "domain_min": {
          "anyOf": [
            {
              "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
              "pattern": "^-?\\d+(/\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Min"
        },
        "domain_max": {
          "anyOf": [
            {
              "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
              "pattern": "^-?\\d+(/\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Max"
        },
        "source": {
          "default": "direct",
          "enum": [
            "direct",
            "points",
            "rise_run"
          ],
          "title": "Source",
          "type": "string"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
                "pattern": "^-?\\d+(/\\d+)?$",
                "type": "string"
              },
              {
                "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
                "pattern": "^-?\\d+(/\\d+)?$",
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        },
        "rise": {
          "anyOf": [
            {
              "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
              "pattern": "^-?\\d+(/\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rise"
        },
        "run": {
          "anyOf": [
            {
              "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
              "pattern": "^-?\\d+(/\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        }
      },
      "required": [
        "x",
        "y",
        "m",
        "c"
      ],
      "title": "LinearModel",
      "type": "object"
    },
    "Solution": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "title": "Answers",
          "type": "array"
        },
        "steps": {
