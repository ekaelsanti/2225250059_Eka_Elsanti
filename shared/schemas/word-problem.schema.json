      "title": "Stimulus",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "find_rate",
            "find_initial",
            "build_model",
            "predict",
            "inverse",
            "intersect",
            "compare",
            "steepness",
            "parallel",
            "perpendicular"
          ],
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
              "pattern": "^-?\\d+(/\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "description": "Bilangan rasional eksak: bilangan bulat atau 'p/q'",
              "pattern": "^-?\\d+(/\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "model": {
          "default": 0,
          "title": "Model",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Task",
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "properties": {
        "meaning": {
          "description": "Arti variabel, mis. 'jarak tempuh'",
